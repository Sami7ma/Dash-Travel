{
  "expo": {
    "name": "DashTravel",
    "slug": "dash-travel-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "dashtravel",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
